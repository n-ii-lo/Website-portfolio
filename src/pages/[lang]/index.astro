---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { LANGS, useUI, type Lang } from '../../i18n/ui';
import { site, projects, html, t } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const ui = useUI(lang);
const experience = site.experience || [];
---
<Base lang={lang} active="work" description={t(site.hero, lang).replace(/[*\[\]]/g, '')}>
  <section class="hero wrap">
    <h1 set:html={html(site.hero, lang)} />
    {experience.length > 0 && (
      <div class="exp">
        <div class="mono">{ui['home.experience']}</div>
        <table>
          <tbody>
            {experience.map((e) => (
              <tr>
                <td class="mono" set:html={html(e.year, lang)} />
                <td>{e.company}</td>
                <td class="muted" set:html={html(e.discipline, lang)} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <section id="work" class="work wrap" aria-labelledby="work-h">
    <h2 id="work-h" class="mono">{ui['home.work']}</h2>
    <div class="grid">
      {projects.map((p, i) => <CaseCard p={p} lang={lang} wide={i === 0} />)}
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 48px; align-items: end;
    padding-top: clamp(48px, 10vw, 140px); padding-bottom: clamp(56px, 8vw, 112px);
  }
  .hero h1 { max-width: 20ch; }
  .hero h1 :global(em) { color: var(--accent); }
  .exp { display: flex; flex-direction: column; gap: 12px; }
  table { border-collapse: collapse; width: 100%; font-size: 15px; }
  td { padding: 10px 16px 10px 0; border-top: 1px solid var(--line); vertical-align: baseline; }
  td:last-child { padding-right: 0; }
  .muted { color: var(--muted); }
  .work h2 { font-size: 12.5px; font-family: var(--f-mono); margin-bottom: 24px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px 32px; }
  .grid > :global(.wide) { grid-column: 1 / -1; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .grid { gap: 48px 24px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 40px; padding-bottom: 56px; }
    .hero h1 { font-size: clamp(34px, 10vw, 44px); line-height: 1.08; }
    .grid { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    /* Experience: year above, company and discipline below */
    table, tbody { display: block; }
    tr { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; padding: 12px 0; border-top: 1px solid var(--line); }
    td { border: 0; padding: 0; }
    td:first-child { grid-column: 1 / -1; }
  }
</style>

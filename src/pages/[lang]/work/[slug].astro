---
import Base from '../../../layouts/Base.astro';
import Block from '../../../components/Block.astro';
import Media from '../../../components/Media.astro';
import { LANGS, useUI, type Lang } from '../../../i18n/ui';
import { projects, html, lines, t, isHex, type Project } from '../../../lib/content';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    projects.map((p, i) => ({ params: { lang, slug: p.slug }, props: { p, next: projects[(i + 1) % projects.length] } })),
  );
}
const { p, next } = Astro.props as { p: Project; next: Project };
const lang = Astro.params.lang as Lang;
const ui = useUI(lang);
const status = (ui.status as Record<string, string>)[p.status || ''] || '';
const eyebrow = [p.company, [status, p.year].filter(Boolean).join(' ')].filter(Boolean).join(' · ');
const sections = (p.sections || []).map((s, i) => ({ ...s, id: `s${i + 1}` }));
const tocSections = sections.filter((s) => s.inToc !== false);
const meta = (['role', 'timeline', 'team', 'skills'] as const).map((k, i) => ({ label: ui['case.meta'][i], items: lines(p[k], lang) }));
---
<Base lang={lang} title={t(p.title, lang)} description={t(p.summary, lang)} active="work" accent={isHex(p.accent) ? p.accent : undefined}>
  <div class="case wrap">
    <aside class="toc">
      <a class="mono back" href={`/${lang}/#work`}>{ui['case.back']}</a>
      <nav aria-label={ui['case.toc']}>
        <ol>
          {tocSections.map((s) => (
            <li><a href={`#${s.id}`} data-toc={s.id} set:html={html(s.title, lang)} /></li>
          ))}
        </ol>
      </nav>
    </aside>

    <article class="body">
      <header class="head">
        <div class="mono">{eyebrow}</div>
        <h1 set:html={html(p.title, lang)} />
      </header>
      <div class="hero-img"><Media image={p.cover} note={p.coverNote} alt={t(p.title, lang)} fallback={t(p.title, lang)} eager /></div>
      <dl class="meta">
        {meta.map((m) => (
          <div>
            <dt class="mono">{m.label}</dt>
            {m.items.map((x) => <dd set:html={html(x, lang)} />)}
          </div>
        ))}
      </dl>

      {tocSections.length > 1 && (
        <details class="mbar" data-mbar>
          <summary>
            <span class="sr">{ui['case.toc']}: </span>
            <span class="mbar-current" data-mbar-current set:html={html(tocSections[0].title, lang)} />
            <span class="mbar-count mono" data-mbar-count>1/{tocSections.length}</span>
            <svg class="chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </summary>
          <ol>
            {tocSections.map((s) => (
              <li><a href={`#${s.id}`} data-toc={s.id} set:html={html(s.title, lang)} /></li>
            ))}
          </ol>
          <span class="mbar-progress" data-progress aria-hidden="true"></span>
        </details>
      )}

      {sections.map((s) => (
        <section id={s.id} class="sec" data-section>
          <div class="mono sec-label" set:html={html(s.title, lang)} />
          {(s.blocks || []).map((b) => <Block block={b} lang={lang} />)}
        </section>
      ))}

      {next && next.slug !== p.slug && (
        <a class="next" href={`/${lang}/work/${next.slug}/`}>
          <span class="mono">{ui['case.next']} →</span>
          <span class="next-title" set:html={html(next.title, lang)} />
        </a>
      )}
    </article>
  </div>
</Base>

<script>
  // Section tracking for the desktop TOC and the phone section bar.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const ids = [...new Set(links.map((a) => a.dataset.toc!))];
  const bar = document.querySelector<HTMLDetailsElement>('[data-mbar]');
  const current = document.querySelector<HTMLElement>('[data-mbar-current]');
  const count = document.querySelector<HTMLElement>('[data-mbar-count]');
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('.body');

  const visible = new Set<string>();
  const setActive = (id: string) => {
    links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.toc === id));
    const src = links.find((a) => a.dataset.toc === id);
    if (current && src) current.innerHTML = src.innerHTML;
    if (count) count.textContent = `${ids.indexOf(id) + 1}/${ids.length}`;
  };
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
      const first = ids.find((id) => visible.has(id));
      if (first) setActive(first);
    },
    { rootMargin: '-20% 0px -60% 0px' },
  );
  ids.forEach((id) => { const el = document.getElementById(id); if (el) io.observe(el); });

  // Reading progress line under the phone section bar.
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!progress || !article) return;
    const r = article.getBoundingClientRect();
    const done = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
    progress.style.transform = `scaleX(${done})`;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();

  // Close the section list after picking a section, on Escape, or on a tap outside.
  bar?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (bar.open = false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && bar?.open) { bar.open = false; bar.querySelector('summary')?.focus(); } });
  document.addEventListener('click', (e) => { if (bar?.open && !bar.contains(e.target as Node)) bar.open = false; });
</script>

<style>
  .case {
    display: grid; grid-template-columns: 180px minmax(0, var(--read)); gap: clamp(32px, 6vw, 96px);
    padding-top: clamp(24px, 5vw, 56px);
  }
  .toc { position: sticky; top: 32px; align-self: start; display: flex; flex-direction: column; gap: 24px; }
  .back { text-decoration: none; min-height: var(--tap); display: inline-flex; align-items: center; align-self: flex-start; margin: -12px 0; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14.5px; line-height: 1.35; }
  .toc a { color: var(--muted); text-decoration: none; transition: color .2s; }
  .toc a:hover, .toc a[aria-current] { color: var(--text); }
  .toc a[aria-current]::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin: 0 8px 2px -14px; }

  .body { min-width: 0; display: flex; flex-direction: column; }
  .head { display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px; }
  .hero-img { aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--line); background: var(--accent-soft); }
  .hero-img :global(.media) { height: 100%; object-fit: cover; }
  .hero-img :global(.ph) { background: var(--accent-soft); }
  .meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 32px 0 0; }
  .meta div { display: flex; flex-direction: column; gap: 6px; }
  .meta dt { margin-bottom: 4px; }
  .meta dd { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.45; }

  /* Phone section bar: sticks to the top once the reader passes the case header */
  .mbar { display: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .sec { padding-top: 88px; display: flex; flex-direction: column; gap: 18px; }
  .sec-label { color: var(--muted); }

  .next {
    margin-top: 120px; padding-top: 28px; border-top: 1px solid var(--line);
    display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--text);
  }
  .next-title { font-family: var(--f-serif); font-size: clamp(28px, 4vw, 44px); line-height: 1.1; transition: color .2s; }
  .next:hover .next-title { color: var(--accent); }

  @media (max-width: 900px) {
    .case { grid-template-columns: minmax(0, 1fr); gap: 16px; padding-top: 8px; }
    .toc { position: static; }
    .toc nav { display: none; }
    .head { margin-bottom: 24px; }

    .mbar {
      display: block; position: sticky; top: 0; z-index: 5; margin: 40px calc(-1 * var(--gutter)) 0;
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }
    .mbar summary {
      list-style: none; cursor: pointer; min-height: 52px; padding: 0 var(--gutter);
      display: flex; align-items: center; gap: 12px; font-size: 15px;
    }
    .mbar summary::-webkit-details-marker { display: none; }
    .mbar-current { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mbar-count { font-size: 12px; }
    .chev { color: var(--muted); transition: transform .2s; flex: none; }
    .mbar[open] { background: var(--bg); }
    .mbar[open] .mbar-progress { opacity: 0; }
    .mbar[open] .chev { transform: rotate(180deg); }
    /* The list overlays the page so opening it does not push the text down */
    .mbar ol {
      position: absolute; left: 0; right: 0; top: 100%;
      list-style: none; margin: 0; padding: 4px 0 12px; max-height: 65vh; overflow-y: auto; overscroll-behavior: contain;
      background: var(--bg); border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 32px -24px color-mix(in srgb, var(--text) 30%, transparent);
    }
    .mbar ol a {
      display: flex; align-items: center; min-height: var(--tap); padding: 0 var(--gutter);
      color: var(--muted); text-decoration: none; font-size: 16px;
    }
    .mbar ol a[aria-current] { color: var(--text); }
    .mbar ol a[aria-current]::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-right: 10px; }
    .mbar-progress {
      position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent);
      transform: scaleX(0); transform-origin: left;
    }
  }
  @media (min-width: 641px) and (max-width: 900px) {
    .meta { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; margin-top: 24px; }
    .meta dd { font-size: 14.5px; }
    .hero-img { aspect-ratio: 4 / 3; }
    .sec { padding-top: 64px; gap: 14px; scroll-margin-top: 20px; }
    .next { margin-top: 80px; padding-bottom: 8px; }
  }
</style>

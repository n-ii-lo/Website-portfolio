---
import Base from '../../layouts/Base.astro';
import { LANGS, useUI, type Lang } from '../../i18n/ui';
import { site, html, paras, inline, t } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const ui = useUI(lang);
const about = paras(site.about, lang);
const contacts = (site.contacts || []).filter((c) => c.value);
const href = (v: string) => (/^[^@\s]+@[^@\s]+$/.test(v) ? `mailto:${v}` : v.startsWith('@') ? `https://t.me/${v.slice(1)}` : v);
---
<Base lang={lang} title={ui['about.title']} active="about">
  <div class="about wrap">
    <div class="intro">
      <div class="mono">{ui['about.title']}</div>
      <h1 set:html={html(site.hero, lang)} />
      {about.length ? about.map((p) => <p set:html={p} />) : <p set:html={inline(ui['about.empty'])} />}
    </div>

    <aside class="side">
      <section>
        <h2 class="mono">{ui['about.experience']}</h2>
        <ul class="rows">
          {(site.experience || []).map((e) => (
            <li><span class="mono" set:html={html(e.year, lang)} /><span>{e.company}</span><span class="muted" set:html={html(e.discipline, lang)} /></li>
          ))}
        </ul>
      </section>
      <section id="contact">
        <h2 class="mono">{ui['about.contacts']}</h2>
        {contacts.length ? (
          <ul class="rows">
            {contacts.map((c) => (
              <li><span class="mono" set:html={html(c.label, lang)} /><a href={href(c.value!)} rel="me">{c.value}</a></li>
            ))}
          </ul>
        ) : <p set:html={inline(ui['about.noContacts'])} />}
      </section>
    </aside>
  </div>
</Base>

<style>
  .about {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: clamp(40px, 6vw, 96px);
    padding-top: clamp(48px, 8vw, 120px);
  }
  .intro { display: flex; flex-direction: column; gap: 20px; }
  .intro h1 { font-size: clamp(32px, 4.4vw, 50px); margin-bottom: 12px; }
  .intro h1 :global(em) { color: var(--accent); }
  .intro p { font-size: 18px; }
  .side { display: flex; flex-direction: column; gap: 48px; }
  .side h2 { font-size: 12.5px; font-family: var(--f-mono); margin-bottom: 12px; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { display: grid; grid-template-columns: 110px 1fr; gap: 4px 16px; padding: 12px 0; border-top: 1px solid var(--line); font-size: 15px; }
  .rows li > :nth-child(3) { grid-column: 2; }
  .muted { color: var(--muted); }
  .rows a { min-height: var(--tap); display: inline-flex; align-items: center; margin: -12px 0; word-break: break-word; }
  @media (max-width: 820px) { .about { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) {
    .about { padding-top: 40px; gap: 48px; }
    .intro p { font-size: 16.5px; }
    .rows li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .rows li > :nth-child(3) { grid-column: 1; }
  }
</style>

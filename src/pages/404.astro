---
import Base from '../layouts/Base.astro';
import { useUI } from '../i18n/ui';
const ui = useUI('ru');
---
<Base lang="ru" title={ui['notFound.title']}>
  <div class="wrap nf">
    <div class="mono">404</div>
    <h1>{ui['notFound.title']}</h1>
    <p><a href="/ru/">{ui['notFound.home']}</a> · <a href="/uk/">На головну</a> · <a href="/en/">Back home</a></p>
  </div>
</Base>
<style>
  .nf { padding-top: 120px; display: flex; flex-direction: column; gap: 20px; }
</style>

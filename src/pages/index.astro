---
// Root: send visitors to their language. Works without JS via meta refresh to Russian.
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="0; url=/ru/" />
    <link rel="canonical" href="/ru/" />
    <title>Портфолио</title>
    <script is:inline>
      (function () {
        var langs = (navigator.languages || [navigator.language || '']).map(function (l) { return String(l).slice(0, 2).toLowerCase(); });
        var pick = 'ru';
        for (var i = 0; i < langs.length; i++) {
          if (langs[i] === 'uk' || langs[i] === 'ru') { pick = langs[i]; break; }
          if (langs[i] === 'en') { pick = 'en'; break; }
        }
        location.replace('/' + pick + '/');
      })();
    </script>
  </head>
  <body><a href="/ru/">Русский</a> · <a href="/uk/">Українська</a> · <a href="/en/">English</a></body>
</html>

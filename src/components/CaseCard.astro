---
import Media from './Media.astro';
import { html, t, isHex, type Project } from '../lib/content';
import { useUI, type Lang } from '../i18n/ui';
import { config } from '../site.config';
interface Props { p: Project; lang: Lang; wide?: boolean }
const { p, lang, wide } = Astro.props;
const ui = useUI(lang);
const status = (ui.status as Record<string, string>)[p.status || ''] || '';
const eyebrow = [p.company, [status, p.year].filter(Boolean).join(' ')].filter(Boolean).join(' · ');
---
<a class:list={['card', { wide }]} href={`/${lang}/work/${p.slug}/`} style={isHex(p.accent) ? `--accent:${p.accent}` : undefined}>
  <div class="cover">
    <Media image={p.cover} note={p.coverNote} alt={t(p.title, lang)} fallback={t(p.title, lang)} />
  </div>
  <div class="card-text">
    <div class="mono">
      {eyebrow}
      {config.showMarkers && !p.published && <span class="draft">{ui['case.draft']}</span>}
    </div>
    <h3 set:html={html(p.title, lang)} />
    {t(p.summary, lang) && <p set:html={html(p.summary, lang)} />}
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 18px; text-decoration: none; color: var(--text); }
  .cover {
    aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius);
    background: var(--accent-soft); border: 1px solid var(--line);
  }
  .wide .cover { aspect-ratio: 16 / 8; }
  .cover :global(.media) { height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2, .7, .2, 1); }
  .cover :global(.ph) { background: var(--accent-soft); color: var(--accent); }
  .card:hover .cover :global(.media) { transform: scale(1.02); }
  .card-text { display: flex; flex-direction: column; gap: 8px; }
  .card h3 { font-size: clamp(22px, 2.4vw, 28px); transition: color .2s; }
  .card:hover h3 { color: var(--accent); }
  @media (max-width: 640px) {
    .card { gap: 14px; }
    .wide .cover { aspect-ratio: 4 / 3; }
    .card h3 { font-size: 24px; }
  }
  .draft { margin-left: 10px; padding: 1px 8px; border: 1px solid var(--line); border-radius: 99px; font-size: 12px; }
</style>

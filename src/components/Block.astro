---
// Renders one content block from the admin (13 types, see portfolio-plan/case-guide.md §5).
import Media from './Media.astro';
import { html, paras, lines, t, type Block } from '../lib/content';
import { useUI, type Lang } from '../i18n/ui';
interface Props { block: Block; lang: Lang }
const { block: b, lang } = Astro.props;
const ui = useUI(lang);
const H = (k: string) => html(b[k], lang);
const items: any[] = Array.isArray(b.items) ? b.items : [];
const shown = (it: any) => it && (it.image?.src || typeof it.image === 'string');
---
{b.type === 'heading' && (b.level === 'h3' ? <h3 class="b-h3" set:html={H('text')} /> : <h2 class="b-h2" set:html={H('text')} />)}

{b.type === 'text' && paras(b.body, lang).map((p) => <p class="b-text" set:html={p} />)}

{b.type === 'label' && <div class="mono b-label" set:html={H('text')} />}

{b.type === 'figure' && (
  <figure class:list={['plate', { tint: b.tint === 'accent' }]}>
    {t(b.caption, lang) && <figcaption class:list={[b.captionStyle === 'italic' ? 'cap-it' : 'mono']} set:html={H('caption')} />}
    {items.some(shown) ? (
      <div class="gallery">
        {items.filter(shown).map((it) => (
          <figure>
            <Media image={it.image} alt={t(it.caption, lang)} fallback={ui['case.noImage']} />
            {t(it.caption, lang) && <figcaption set:html={html(it.caption, lang)} />}
          </figure>
        ))}
      </div>
    ) : (
      <Media note={b.note} fallback={ui['case.noImage']} />
    )}
    {Array.isArray(b.callouts) && b.callouts.length > 0 && (
      <ul class="callouts">{b.callouts.map((c: any) => t(c.text, lang) && <li set:html={html(c.text, lang)} />)}</ul>
    )}
  </figure>
)}

{b.type === 'flows' && (
  <div class="flows">
    {items.map((it) => (
      <div class="flow">
        <div class="plate shot"><Media image={it.image} note={it.note} alt={t(it.title, lang)} fallback={ui['case.noImage']} /></div>
        <div class="flow-text">
          <h3 set:html={html(it.title, lang)} />
          {t(it.body, lang) && <p set:html={html(it.body, lang)} />}
        </div>
      </div>
    ))}
  </div>
)}

{b.type === 'stats' && (
  <div class="stats-wrap">
    {t(b.label, lang) && <div class="mono b-label" set:html={H('label')} />}
    <div class:list={['cols', items.length === 2 ? 'c2' : 'c3']}>
      {items.map((it) => {
        const v = t(it.value, lang);
        return (
          <div>
            <div class:list={['stat', { claim: v.length > 14 }]} set:html={html(it.value, lang)} />
            <p set:html={html(it.caption, lang)} />
          </div>
        );
      })}
    </div>
  </div>
)}

{b.type === 'columns' && (
  <div class="stats-wrap">
    {t(b.label, lang) && <div class="mono b-label" set:html={H('label')} />}
    <div class:list={['cols', items.length >= 3 ? 'c3' : 'c2']}>
      {items.map((it, i) => (
        <div>
          <h3>{b.numbered && <span class="num">{`${i + 1}. `}</span>}<Fragment set:html={html(it.title, lang)} /></h3>
          <p set:html={html(it.body, lang)} />
        </div>
      ))}
    </div>
  </div>
)}

{b.type === 'quote' && <blockquote class:list={['quote', `q-${b.kind || 'insight'}`]} set:html={H('text')} />}

{b.type === 'exploration' && (
  <div class="explore">
    <h3 set:html={H('title')} />
    {t(b.hypothesis, lang) && <p set:html={H('hypothesis')} />}
    <figure class="plate">
      <span class="pill mono">{ui['case.before']}</span>
      <Media image={b.image} note={b.note} fallback={ui['case.noImage']} />
    </figure>
    {t(b.verdict, lang) && <blockquote class="quote" set:html={H('verdict')} />}
  </div>
)}

{b.type === 'options' && (
  <figure class="plate">
    {t(b.caption, lang) && <figcaption class="mono" set:html={H('caption')} />}
    {b.current && (b.current.src || typeof b.current === 'string') && (
      <Fragment>
      <div class="opt"><div class="mono">{ui['case.current']}</div><Media image={b.current} fallback={ui['case.noImage']} /></div>
      <div class="arrow" aria-hidden="true">↓</div>
      </Fragment>
    )}
    <div class="opts">
      {items.map((it) => (
        <div class:list={['opt', { chosen: it.chosen }]}>
          <div class="mono" set:html={html(it.label, lang)} />
          <div class="opt-shot"><Media image={it.image} alt={t(it.label, lang)} fallback={ui['case.noImage']} /></div>
        </div>
      ))}
    </div>
  </figure>
)}

{b.type === 'beforeAfter' && (
  <figure class="plate">
    {t(b.caption, lang) && <figcaption class="cap-it" set:html={H('caption')} />}
    <div class="ba">
      <div class="mono">{ui['case.ba'][0]}</div>
      <Media image={b.before} fallback={ui['case.noImage']} />
      <ul class="notes before">{lines(b.beforeNotes, lang).map((x) => <li set:html={html(x, lang)} />)}</ul>
    </div>
    <div class="arrow" aria-hidden="true">↓</div>
    <div class="ba">
      <div class="mono accent">{ui['case.ba'][1]}</div>
      <Media image={b.after} fallback={ui['case.noImage']} />
      <ul class="notes after">{lines(b.afterNotes, lang).map((x) => <li set:html={html(x, lang)} />)}</ul>
    </div>
  </figure>
)}

{b.type === 'goals' && (
  <div class="plate goals">
    {items.map((it) => (
      <div class="goal">
        <div class="g" set:html={html(it.goal, lang)} />
        <div class="arrow" aria-hidden="true">→</div>
        <div class="r"><b set:html={html(it.value, lang)} /><span set:html={html(it.caption, lang)} /></div>
      </div>
    ))}
  </div>
)}

{b.type === 'divider' && <hr class="divider" />}

<style>
  .b-h2 { margin-top: 8px; }
  .b-h3 { margin-top: 8px; }
  .b-label { margin-top: 16px; }
  .b-text { font-size: 17px; }

  .plate {
    margin: 8px 0; padding: clamp(16px, 2.5vw, 28px); background: var(--bg-alt);
    border: 1px solid var(--line); border-radius: var(--radius);
    display: flex; flex-direction: column; gap: 16px;
  }
  .plate.tint { background: var(--accent-soft); }
  .cap-it { font-family: var(--f-serif); font-style: italic; font-size: 20px; }
  .plate :global(.ph) { background: var(--bg); }
  .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .gallery figure { margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: 14px; color: var(--muted); }
  .callouts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .callouts li { font-size: 13px; padding: 4px 10px; background: var(--bg); border: 1px solid var(--line); }

  .flows { display: flex; flex-direction: column; gap: 40px; margin: 8px 0; }
  .flow { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 32px; align-items: end; }
  .shot { margin: 0; padding: 0; overflow: hidden; }
  .shot:not(:has(.media)) { aspect-ratio: 16 / 10; }
  .shot :global(.media) { max-height: min(80vh, 760px); width: 100%; object-fit: contain; }
  .flow-text { display: flex; flex-direction: column; gap: 8px; }

  .stats-wrap { display: flex; flex-direction: column; gap: 16px; margin: 8px 0; }
  .cols { display: grid; gap: 24px 32px; }
  .cols.c2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cols.c3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cols > div { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .stat { font-family: var(--f-serif); font-size: 34px; line-height: 1.15; color: var(--accent); }
  .stat.claim { font-size: 22px; line-height: 1.3; color: var(--text); }
  .num { color: var(--accent); }

  .quote {
    margin: 8px 0; padding: 4px 0 4px 20px; border-left: 2px solid var(--accent);
    font-family: var(--f-serif); font-style: italic; font-size: 22px; line-height: 1.4; max-width: 60ch;
  }
  .q-hmw {
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); background: var(--accent-soft);
    color: var(--accent); text-align: center; padding: 24px; font-style: normal; max-width: none;
  }
  .q-nda { border-left-color: var(--muted); color: var(--muted); }

  .explore { display: flex; flex-direction: column; gap: 12px; }
  .pill { align-self: flex-start; color: var(--accent); border: 1px solid var(--accent); border-radius: 99px; padding: 1px 10px; font-size: 12px; }

  .opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .opt { display: flex; flex-direction: column; gap: 8px; }
  .opt-shot { border: 1px solid var(--line); background: var(--bg); aspect-ratio: 16 / 10; overflow: hidden; }
  .opt.chosen .opt-shot { border: 2px solid var(--accent); }
  .opt.chosen .mono { color: var(--accent); }
  .arrow { text-align: center; color: var(--muted); font-size: 22px; }

  .ba { display: flex; flex-direction: column; gap: 10px; }
  .accent { color: var(--accent); }
  .notes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .notes li { font-size: 13px; padding: 3px 8px; }
  .notes.before li { background: var(--bg); color: var(--muted); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--muted) 50%, transparent); }
  .notes.after li { background: var(--accent-soft); color: var(--accent); }

  .goal { display: grid; grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr); gap: 12px; align-items: center; }
  .goal .g { background: var(--bg-alt); border: 1px solid var(--line); padding: 14px 16px; font-size: 15px; color: var(--muted); }
  .goal .r { background: var(--bg); border: 1px solid var(--line); padding: 14px 16px; display: flex; flex-direction: column; color: var(--muted); font-size: 14px; }
  .goal .r b { font-family: var(--f-serif); font-weight: 400; font-size: 28px; color: var(--accent); }

  .divider { border: 0; border-top: 1px solid var(--line); margin: 48px 0 0; }

  @media (max-width: 720px) {
    .flow, .cols.c2, .cols.c3 { grid-template-columns: minmax(0, 1fr); }
    .flow { gap: 14px; }
    .flows { gap: 36px; }
    .goal { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .goal .arrow { display: block; font-size: 18px; line-height: 28px; transform: rotate(90deg); }
  }
  @media (max-width: 640px) {
    /* Plates go edge to edge so screenshots get the full phone width */
    .plate {
      margin-inline: calc(-1 * var(--gutter)); border-radius: 0; border-left: 0; border-right: 0;
      padding: 16px var(--gutter); gap: 12px;
    }
    .plate :global(.ph) { min-height: 160px; padding: 16px; }
    .shot :global(.media) { max-height: 68vh; }
    .gallery { grid-template-columns: minmax(0, 1fr); }
    .opts { gap: 12px; }
    .b-text { font-size: 16px; }
    .cap-it { font-size: 18px; }
    .quote { font-size: 19px; padding-left: 16px; }
    .q-hmw { padding: 18px; }
    .stat { font-size: 30px; }
    .cols { gap: 20px; }
    .divider { margin-top: 32px; }
  }
</style>

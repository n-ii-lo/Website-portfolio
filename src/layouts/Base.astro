---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { LANGS, LANG_LABEL, LANG_NAME, swapLang, useUI, type Lang } from '../i18n/ui';
import { site, t, html } from '../lib/content';

interface Props { lang: Lang; title?: string; description?: string; active?: 'work' | 'about'; accent?: string }
const { lang, title, description, active, accent } = Astro.props;
const ui = useUI(lang);
const name = t(site.name, lang).replace(/\s*\[[^\]]*\]/g, '');
const role = t(site.roleLine, lang);
const pageTitle = title ? `${title} · ${name}` : `${name} · ${role}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FAFAF8" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(swapLang(path, l), Astro.site)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
  </head>
  <body style={accent ? `--accent:${accent}` : undefined}>
    <a class="skip" href="#main">{ui['skip']}</a>
    <header class="top wrap">
      <a class="brand mono" href={`/${lang}/`}>
        <span class="brand-name">{name}</span>
        <span class="brand-role">{role}</span>
      </a>
      <nav class="nav mono" aria-label="Main">
        <a href={`/${lang}/#work`} aria-current={active === 'work' ? 'page' : undefined}>{ui['nav.work']}</a>
        <a href={`/${lang}/about/`} aria-current={active === 'about' ? 'page' : undefined}>{ui['nav.about']}</a>
        <span class="langs" role="group" aria-label={ui['nav.lang']}>
          {LANGS.map((l) => (
            <a href={swapLang(path, l)} hreflang={l} lang={l} title={LANG_NAME[l]} aria-current={l === lang ? 'true' : undefined}>{LANG_LABEL[l]}</a>
          ))}
        </span>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <dialog class="zoom" data-zoom-dialog aria-label="Image">
      <img alt="" />
    </dialog>

    <footer class="wrap">
      <div class="foot mono">
        <span set:html={html(site.footer, lang)} />
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
    <script>
      // Tap a screenshot to see it full screen; tap again or Esc to close.
      const dlg = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]');
      const big = dlg?.querySelector('img');
      document.addEventListener('click', (e) => {
        const img = (e.target as Element).closest<HTMLImageElement>('img[data-zoom]');
        if (!img || !dlg || !big || img.closest('a')) return;
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        dlg.showModal();
      });
      dlg?.addEventListener('click', () => dlg.close());
    </script>
  </body>
</html>

<style>
  .top {
    display: flex; justify-content: space-between; align-items: center; gap: 0 32px; flex-wrap: wrap;
    padding-top: 16px; padding-bottom: 16px;
  }
  /* Links keep a 44px touch area; negative margins keep the visual rhythm tight */
  .brand, .nav a { min-height: var(--tap); display: inline-flex; align-items: center; }
  .brand { gap: 0 24px; flex-wrap: wrap; text-decoration: none; color: var(--text); }
  .brand-role { color: var(--muted); }
  .nav { display: flex; gap: 0 24px; align-items: center; flex-wrap: wrap; }
  .nav a { text-decoration: none; min-width: var(--tap); }
  .nav a[aria-current] { color: var(--accent); }
  .langs { display: inline-flex; padding-left: 14px; position: relative; }
  .langs::before { content: ""; position: absolute; left: 0; top: 13px; bottom: 13px; border-left: 1px solid var(--line); }
  .langs a { min-width: var(--tap); justify-content: center; }
  :global(img[data-zoom]) { cursor: zoom-in; }
  .zoom {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: var(--bg); display: none; place-items: center; cursor: zoom-out;
  }
  .zoom[open] { display: grid; }
  .zoom img { max-width: 100%; max-height: 100dvh; object-fit: contain; touch-action: pinch-zoom; }
  .zoom::backdrop { background: var(--bg); }
  .foot {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    margin-top: 120px; padding: 20px 0 max(40px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
  }
  @media (max-width: 640px) {
    .top { padding-top: 8px; padding-bottom: 8px; }
    .brand { flex-direction: column; align-items: flex-start; justify-content: center; line-height: 1.5; padding: 6px 0; }
    .nav { width: 100%; justify-content: space-between; gap: 0 20px; margin-top: 4px; border-top: 1px solid var(--line); }
    .langs { padding-left: 0; margin-right: -12px; }
    .langs::before { display: none; }
    .foot { margin-top: 80px; }
  }
</style>
